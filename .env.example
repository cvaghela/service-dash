# OPTIONAL OVERRIDES
# Service Dash runs without a .env file. Copy this file to .env only when a
# value below differs from the defaults in docker-compose.yml.

# Port exposed by the dashboard container on the Docker host.
DASHBOARD_PORT=8888

# URL must be reachable from inside the dashboard container.
# Do not add /kuma to this upstream URL.
KUMA_UPSTREAM=http://host.docker.internal:3001

# The final path segment from your published Uptime Kuma status-page URL.
# Example: http://kuma.local/status/homelab means STATUS_SLUG=homelab
STATUS_SLUG=homelab

# Initial storage mount. "auto" prefers a named ZimaOS data disk.
# The Sources dropdown can select and aggregate additional mounts per browser.
# Example override: STORAGE_MOUNT=/media/1TB-SSD-1
STORAGE_MOUNT=auto

# Netdata is included in this stack. Its private internal address is fixed in
# docker-compose.yml and should not be added here.
