FROM node:22-alpine

WORKDIR /app

# Dependencies first, so a change to the service does not re-resolve them.
COPY kuma-auth/package.json kuma-auth/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY kuma-auth/server.js ./server.js

# No shell, no package manager reachable at runtime, and never root.
USER node

EXPOSE 2371

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('node:http').get('http://127.0.0.1:2371/healthz',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

CMD ["node", "server.js"]
