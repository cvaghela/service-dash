map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}


server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location = /config.js {
        try_files $uri =404;
        add_header Cache-Control "no-store";
        expires -1;
    }

    location = /docker-metadata/networks {
        proxy_pass http://docker-metadata:2375/networks;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_read_timeout 5s;
        add_header Cache-Control "no-store";
    }

    location /docker-metadata/networks/ {
        proxy_pass http://docker-metadata:2375/networks/;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_read_timeout 5s;
        add_header Cache-Control "no-store";
    }

    # Settings are readable by anyone who can reach the dashboard, and writable
    # only by someone signed in to Uptime Kuma. nginx cannot verify a Kuma token
    # and a browser claiming to be signed in proves nothing, so the question is
    # put to Kuma itself through the validator below.
    location = /settings/state.json {
        root /var/lib/service-dash;

        # auth_request takes a literal URI and cannot be made conditional, so
        # every request is checked and the validator decides: reads pass, writes
        # need a Kuma session.
        auth_request /_kuma-auth;

        # DELETE is not exposed: the dashboard never uses it.
        dav_methods PUT;
        create_full_put_path on;
        dav_access user:rw group:rw all:r;

        # Must sit on the same filesystem as the document — WebDAV writes a temp
        # file and renames it, and rename cannot cross mounts.
        client_body_temp_path /var/lib/service-dash/tmp;
        client_max_body_size 256k;

        add_header Cache-Control "no-store";
    }

    # Reachable only as an auth_request subrequest, never from outside. A
    # validator that is down, slow, or unhappy means the write is refused.
    location = /_kuma-auth {
        internal;

        proxy_pass http://kuma-auth:2371/validate;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Kuma-Token $http_x_kuma_token;
        # The subrequest is always a GET; this carries the real method.
        proxy_set_header X-Original-Method $request_method;
        proxy_connect_timeout 5s;
        proxy_read_timeout 6s;
    }

    location = /network-info/status {
        alias /var/run/network-info/status.json;
        default_type application/json;
        add_header Cache-Control "no-store";
    }

    location = /kuma {
        return 301 /kuma/;
    }

    location /kuma/socket.io/ {
        proxy_pass ${KUMA_UPSTREAM}/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }

    location /kuma/ {
        proxy_pass ${KUMA_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
        proxy_buffering off;
    }

    location = /netdata {
        return 301 /netdata/;
    }

    location /netdata/ {
        proxy_pass http://netdata:19999/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
        proxy_buffering off;
    }

    # The icon catalogue, proxied rather than fetched by the browser: it keeps
    # the page's connect-src on 'self', and it is the only way the index can be
    # read at all under that policy. ~59 KB gzipped, cached for a day.
    location = /icon-index {
        # Docker's embedded resolver — the upstream is looked up at request time.
        resolver 127.0.0.11 valid=300s ipv6=off;
        set $icon_index_host "cdn.jsdelivr.net";
        proxy_pass https://$icon_index_host/gh/selfhst/icons/index.json;

        proxy_ssl_server_name on;
        proxy_set_header Host $icon_index_host;
        # Pass the upstream's gzip straight through instead of inflating it.
        proxy_set_header Accept-Encoding "gzip";
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;

        default_type application/json;
        add_header Cache-Control "public, max-age=86400";
    }

    location /assets/ {
        try_files $uri =404;
        access_log off;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    location /samples/ {
        try_files $uri =404;
        access_log off;
        expires 1h;
    }

    location / {
        try_files $uri $uri/ /index.html;

        # The dashboard renders image URLs that anyone with write access to the
        # settings document can choose, so the policy bounds what those URLs can
        # reach. img-src allows https and same-origin only: a plain-http URL
        # aimed at LAN equipment cannot be loaded, which is the request a
        # malicious icon would otherwise make from each viewer's browser.
        # Self-hosted icons still work over a relative path such as /icons/x.png.
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
    }
}
